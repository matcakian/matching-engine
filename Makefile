# Compiler and language settings shared by the demo and test targets.
CXX := c++
CXXFLAGS := -std=c++20 -Wall -Wextra -Wpedantic -Iinclude

# Keep generated files separate from source files.
BUILD_DIR := build
ENGINE_SOURCE := src/order_book.cpp

.PHONY: all run test clean

# Build the interactive example by default.
all: $(BUILD_DIR)/matching_engine_demo

# Compile the demo together with the matching-engine implementation.
$(BUILD_DIR)/matching_engine_demo: src/main.cpp $(ENGINE_SOURCE) include/matching_engine/order_book.hpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) src/main.cpp $(ENGINE_SOURCE) -o $@

# Compile the assertion-based test executable.
$(BUILD_DIR)/matching_engine_tests: tests/order_book_tests.cpp $(ENGINE_SOURCE) include/matching_engine/order_book.hpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) tests/order_book_tests.cpp $(ENGINE_SOURCE) -o $@

# Create the output directory only when a build target needs it.
$(BUILD_DIR):
	mkdir -p $@

# Build and run the example program.
run: $(BUILD_DIR)/matching_engine_demo
	./$(BUILD_DIR)/matching_engine_demo

# Build and execute the test suite.
test: $(BUILD_DIR)/matching_engine_tests
	./$(BUILD_DIR)/matching_engine_tests

# Remove only files generated by this Makefile.
clean:
	rm -rf $(BUILD_DIR)
